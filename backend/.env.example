# Which provider generates text: "groq" (fast, generous free tier) or "gemini".
# Embeddings always use Gemini (Groq has no embeddings API).
LLM_PROVIDER=groq

# Google Gemini API key (free tier, used for embeddings + optional generation):
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq API key (free tier, used for generation): https://console.groq.com/keys
GROQ_API_KEY=

# --- Models (sensible free-tier defaults; override if you like) ------------
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Storage (defaults live under backend/data/) --------------------------
# DATABASE_URL=sqlite:///./data/app.db
# CHROMA_DIR=./data/chroma
# KNOWLEDGE_BASE_DIR=./data/knowledge_base

# --- RAG tuning -----------------------------------------------------------
# Larger chunks keep the whole corpus while staying under free-tier embedding
# limits (fewer chunks = fewer embedding requests).
CHUNK_SIZE=2600
CHUNK_OVERLAP=300
RETRIEVAL_TOP_K=6
EMBEDDING_BATCH_SIZE=40
# Throttle bulk embedding below Gemini's 100 requests/min free-tier cap.
EMBEDDING_REQUESTS_PER_MINUTE=90

# --- Interview behaviour --------------------------------------------------
QUESTIONS_PER_INTERVIEW=5

# --- CORS (comma-separated frontend origins) ------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
